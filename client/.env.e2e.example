# E2E auth tests create their own accounts, so no test-user credentials are needed.
#
# The auth forms require Cloudflare Turnstile. Locally, set a site key in client/.env:
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Use the matching "always passes" secret in server/.dev.vars:
#   TURNSTILE_SECRET=1x0000000000000000000000000000000AA
#
# CI uses the same Cloudflare test keys.
