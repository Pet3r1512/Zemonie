{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zemonie-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-14",
  "compatibility_flags": ["nodejs_compat"],

  "routes": [
    {
      "pattern": "api.zemonie.site",
      "custom_domain": true,
    },
  ],
  "vars": {
    "NODE_ENV": "production",
    "PORT": "9999",
    "LOG_LEVEL": "info",
    "BETTER_AUTH_URL": "https://api.zemonie.site",
    "TRUSTED_ORIGINS": "https://www.zemonie.site,https://zemonie.site",
    "BASE_URL": "https://api.zemonie.site",
    "EMAIL_SEND_INTERVAL_SECONDS": "60",
    "EMAIL_RECIPIENT_DAILY_LIMIT": "5",
    "EMAIL_DAILY_LIMIT": "250",
  },

  "triggers": {
    "crons": ["*/15 * * * *", "0 0 * * *"],
  },
}
