# Copy this file to .env.dev and fill in real values for local development.
# Never commit .env.dev — it is gitignored.

# CLIENT
# Your CLIENT local url
VITE_SERVER_URL=""

# SERVER
# `development` activates hot reloads, verbose logging and detailed error stack traces.
# Use `production` for deployed builds.
NODE_ENV="development"
# The TCP port the dev server listens on. Leave empty when using default port.
PORT=
# debug | info | warn | error
LOG_LEVEL=info

# Amounts field encryption key
ENCRYPTION_KEY=

# Better Auth signing secret
BETTER_AUTH_SECRET=

# Your SERVER local url
BETTER_AUTH_URL=
BASE_URL=

# Same as CLIENT local url
TRUSTED_ORIGINS=

# Database
DEV_DATABASE_URL=
DEV_DIRECT_URL=

# Brevo email service API key (get from Brevo dashboard — never commit real keys)
BREVO_API_KEY=
